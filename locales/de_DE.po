msgid "The installation manifest is missing or unreadable: install the plugin again."
msgstr "Das Installationsmanifest fehlt oder ist nicht lesbar: Installieren Sie das Plugin erneut."

#, php-format
msgid "A profile named \"%s\" already exists: it is not changed."
msgstr "Ein Profil namens „%s“ existiert bereits: Es wird nicht geändert."

#, php-format
msgid "The profile \"%s\" could not be created."
msgstr "Das Profil „%s“ konnte nicht angelegt werden."

#, php-format
msgid "A user named \"%s\" already exists: it is not changed."
msgstr "Ein Benutzer namens „%s“ existiert bereits: Er wird nicht geändert."

#, php-format
msgid "The user \"%s\" could not be created."
msgstr "Der Benutzer „%s“ konnte nicht angelegt werden."

msgid "The profile could not be given to the API user."
msgstr "Das Profil konnte dem API-Benutzer nicht zugewiesen werden."

#, php-format
msgid "An API client named \"%s\" already exists: it is not changed."
msgstr "Ein API-Client namens „%s“ existiert bereits: Er wird nicht geändert."

#, php-format
msgid "The API client \"%s\" could not be created."
msgstr "Der API-Client „%s“ konnte nicht angelegt werden."

msgid "The tokens could not be generated."
msgstr "Die Token konnten nicht erzeugt werden."

msgid "The installation is up to date."
msgstr "Die Installation ist aktuell."

msgid "The REST API of GLPI and the login with a user token are enabled."
msgstr "Die REST-API von GLPI und die Anmeldung mit Benutzer-Token sind aktiviert."

msgid "Installation"
msgstr "Installation"

msgid "What i-REST needs to connect to this GLPI: profile, API user and API client. Only the elements created here are completed; nothing that exists is changed."
msgstr "Was i-REST braucht, um sich mit diesem GLPI zu verbinden: Profil, API-Benutzer und API-Client. Nur die hier angelegten Elemente werden ergänzt; Vorhandenes wird nicht geändert."

msgid "Copy these tokens into the i-REST connection: they will never be shown again."
msgstr "Kopieren Sie diese Token in die i-REST-Verbindung: Sie werden nie wieder angezeigt."

msgid "Application token"
msgstr "Anwendungs-Token"

msgid "User token"
msgstr "Benutzer-Token"

msgid "This GLPI is already configured for i-REST: no user was created automatically. Use \"Create / complete\" only to move to the user managed by the plugin."
msgstr "Dieses GLPI ist bereits für i-REST eingerichtet: Es wurde kein Benutzer automatisch angelegt. Verwenden Sie „Anlegen / ergänzen“ nur, um zum vom Plugin verwalteten Benutzer zu wechseln."

msgid "Already exists, not managed"
msgstr "Existiert bereits, nicht verwaltet"

msgid "Create / complete"
msgstr "Anlegen / ergänzen"

msgid "Create read-only (trial)"
msgstr "Nur lesend anlegen (Test)"

msgid "Enable the REST API"
msgstr "REST-API aktivieren"

msgid "Generate the tokens"
msgstr "Token erzeugen"

msgid "Generate new tokens? The previous ones will stop working."
msgstr "Neue Token erzeugen? Die bisherigen funktionieren dann nicht mehr."

msgid "Prerequisites of the workflows"
msgstr "Voraussetzungen der Workflows"
